create database customer_behaviour;
use customer_behaviour;

SELECT
    @@SERVERNAME AS Server_Name,
    DB_NAME() AS Database_Name,
    SYSTEM_USER AS Login_Name;


USE customer_behaviour;

SELECT TOP 10 *
FROM dbo.customers;



-- Q1. Total revenue generated by male vs. female customers
SELECT
    gender,
    SUM(purchased_amount) AS revenue
FROM dbo.customers
GROUP BY gender;


-- Q2. Customers who used a discount but spent more than average
SELECT
    customer_id,
    purchased_amount
FROM dbo.customers
WHERE discount_applied = 'Yes'
  AND purchased_amount > (
      SELECT AVG(purchased_amount)
      FROM dbo.customers
  );


-- Q3. Top 5 products with the highest average review rating
SELECT TOP 5
    item_purchased,
    ROUND(AVG(CAST(review_rating AS DECIMAL(10,2))), 2) AS average_product_rating
FROM dbo.customers
GROUP BY item_purchased
ORDER BY average_product_rating DESC;


-- Q4. Average purchase amount: Standard vs Express shipping
SELECT
    shipping_type,
    ROUND(AVG(CAST(purchased_amount AS DECIMAL(10,2))), 2) AS avg_purchase_amount
FROM dbo.customers
WHERE shipping_type IN ('Standard', 'Express')
GROUP BY shipping_type;


-- Q5. Average spend and total revenue: Subscribers vs Non-subscribers
SELECT
    subscription_status,
    COUNT(customer_id) AS total_customers,
    ROUND(AVG(CAST(purchased_amount AS DECIMAL(10,2))), 2) AS avg_spend,
    SUM(purchased_amount) AS total_revenue
FROM dbo.customers
GROUP BY subscription_status
ORDER BY total_revenue DESC, avg_spend DESC;


-- Q6. Top 5 products with the highest discount purchase percentage
SELECT TOP 5
    item_purchased,
    ROUND(
        100.0 * SUM(CASE WHEN discount_applied = 'Yes' THEN 1 ELSE 0 END)
        / COUNT(*), 2
    ) AS discount_rate
FROM dbo.customers
GROUP BY item_purchased
ORDER BY discount_rate DESC;


-- Q7. Segment customers into New, Returning, and Loyal
WITH customer_type AS (
    SELECT
        customer_id,
        previous_purchases,
        CASE
            WHEN previous_purchases = 1 THEN 'New'
            WHEN previous_purchases BETWEEN 2 AND 10 THEN 'Returning'
            ELSE 'Loyal'
        END AS customer_segment
    FROM dbo.customers
)
SELECT
    customer_segment,
    COUNT(*) AS number_of_customers
FROM customer_type
GROUP BY customer_segment;


-- Q8. Top 3 most purchased products within each category
WITH item_counts AS (
    SELECT
        category,
        item_purchased,
        COUNT(customer_id) AS total_orders,
        ROW_NUMBER() OVER (
            PARTITION BY category
            ORDER BY COUNT(customer_id) DESC
        ) AS item_rank
    FROM dbo.customers
    GROUP BY category, item_purchased
)
SELECT
    item_rank,
    category,
    item_purchased,
    total_orders
FROM item_counts
WHERE item_rank <= 3
ORDER BY category, item_rank;


-- Q9. Repeat buyers and their subscription status
SELECT
    subscription_status,
    COUNT(customer_id) AS repeat_buyers
FROM dbo.customers
WHERE previous_purchases > 5
GROUP BY subscription_status;


-- Q10. Revenue contribution of each age group
SELECT
    age_group,
    SUM(purchased_amount) AS total_revenue
FROM dbo.customers
GROUP BY age_group
ORDER BY total_revenue DESC;

